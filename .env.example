# ==============================================================================
# Metrivio X Growth Engine — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env itself —
# it is already excluded in .gitignore. Nothing in this file is a real secret.
#
# Per RISK_REGISTER.md #9 (Credential Exposure Risk): credential values must
# never appear in audit_log rows, log lines, or source code. This file is the
# only place they are configured, and it stays out of version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core application
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# SQLite database file path (WAL mode). Back this file (plus -wal/-shm siblings)
# up on a schedule per DATABASE.md §6.
DATABASE_PATH=./var/metrivio.sqlite

# 32-byte hex key used to encrypt stored credentials at rest (AES-256-GCM),
# matching the pattern already used by the vendored X-Manager instance.
# Generate with: openssl rand -hex 32
# Required in production; a random one is generated at runtime in development
# if unset (and logged as a warning, never as a value).
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Automation safety defaults (ARCHITECTURE.md §7 / §1.4)
# ------------------------------------------------------------------------------
# One of: dry_run | approval_required | autonomous
# Default is dry_run on first boot for both subsystems, per BUILD_PLAN.md
# Stage 1 exit criteria. Changing these later is a Settings/system_config
# change, not a code change — these env vars only seed the first-boot default.
PROSPECTING_OUTREACH_AUTOMATION_MODE=dry_run
CONTENT_PUBLISHING_AUTOMATION_MODE=dry_run

# Global kill switch. When "true", every write-adapter call is refused before
# it reaches the adapter, regardless of automation mode. Seeds system_config
# on first boot only; toggle at runtime via system_config from then on.
KILL_SWITCH=false

# Conservative first-boot daily limits (plain numbers, freely adjustable later
# via system_config — never hardcoded in pipeline logic).
DAILY_LIMIT_DMS=5
DAILY_LIMIT_FOLLOWS=0
DAILY_LIMIT_POSTS=3
DAILY_LIMIT_SCRAPES=200

# Whether a degraded/at_risk Session Health state is allowed to automatically
# slow down or downgrade autonomous mode. On by default (ARCHITECTURE.md §3.5).
SESSION_HEALTH_AUTO_DOWNGRADE=true

# ------------------------------------------------------------------------------
# XActions — read adapter (discovery/enrichment/engagement) and DM write path
# (RESEARCH.md §2/§5). Session-cookie based, not an official API key.
# ------------------------------------------------------------------------------
XACTIONS_SESSION_COOKIE=
XACTIONS_CT0_TOKEN=

# ------------------------------------------------------------------------------
# X-Manager (vendored) — official X API OAuth 1.0a app credentials, used for
# posting/scheduling/replying (RESEARCH.md §3).
# ------------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_MANAGER_ADMIN_TOKEN=
X_MANAGER_ENCRYPTION_KEY=
X_MANAGER_SESSION_SECRET=

# ------------------------------------------------------------------------------
# OpenTechAnalyzer — no API key required for core detection (RESEARCH.md §2A).
# Only needed if/when the deferred V2 reverse-lookup capability is enabled.
# ------------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# LLM (drafting, classification, evidence extraction — never scoring math)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
